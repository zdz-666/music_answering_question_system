# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 排除，密钥不会进入 git。

# ---- 对话模型与向量模型（OpenAI 兼容接口）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=

# ---- 图像理解模型（VLM，可选）----
# 把上传 PDF/DOCX 里的图片转成文字描述；与对话模型共用同一个 OpenAI 兼容网关，只填 model 名。
# 留空则不生成图片描述（上传仍可用，图片位置会标注为「未生成描述」）。
VLM_MODEL=
VLM_TIMEOUT=30

# ---- 上传文档解析 ----
# 宽或高小于该像素的图片直接丢弃（滤掉 logo、页码装饰、小图标）
IMAGE_MIN_SIZE=100
# 抽出的图片与描述缓存的落盘目录
UPLOAD_IMAGE_DIR=./uploaded_images

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10

# ---- 重排序（SiliconFlow）----
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_TIMEOUT=10

# ---- 外部 HTTP 调用重试次数（首次 + N 次重试；仅对超时/网络错误/5xx/429 生效）----
HTTP_RETRIES=2

# ---- 检索策略 ----
# 首轮检索后最多追加几轮补充检索（硬上限，防止无限循环）；0 表示关闭补充检索
MAX_SUPPLEMENT_ROUNDS=2

# ---- Chroma 向量库持久化目录（只服务知识库）----
# 知识库的三个集合（自我介绍 / 音乐理解 / 歌单）仍落在 Chroma；
# 会话存在 Redis、长期记忆存在 MEMORY_ROOT 的目录里，都不使用这个目录。
CHROMA_PERSIST_DIR=./chroma_db

# ---- 长期记忆（文件式，按 user_id 分目录）----
# 每条记忆是一个 Markdown 文件（YAML frontmatter: name/description/type），
# 目录里另有 MEMORY.md 作为索引；回答前用 LLM 从索引挑出相关记忆注入 system prompt，
# 一轮结束后抽取新记忆落盘。落点目录已在 .gitignore 中排除。
MEMORY_ROOT=./.memory
# 单次注入 system prompt 的记忆正文总字符上限 / 最多召回条数
MEMORY_RECALL_CHAR_LIMIT=20000
MEMORY_RECALL_TOP_K=5
# 记忆条数达到该阈值时触发一次合并；合并正文超过该字符数则跳过本次合并
MEMORY_CONSOLIDATE_THRESHOLD=10
MEMORY_CONSOLIDATE_CHAR_LIMIT=20000
# read_file 工具单次返回的字符上限（可读：当前用户记忆目录、压缩归档目录）
READ_FILE_CHAR_LIMIT=20000

# ---- 上下文压缩（agent_loop 每轮调用模型前对聊天消息瘦身）----
# 阈值含义见 context_compact.py：总量超限就逐级压缩，直到汇总成一条摘要。
CONTEXT_CHAR_LIMIT=50000
TOOL_RESULT_BATCH_CHAR_LIMIT=200000
LARGE_RESULT_CHAR_LIMIT=30000
SUMMARY_INPUT_CHAR_LIMIT=80000
KEEP_RECENT_RESULTS=3
KEEP_RECENT_MESSAGES=5
# snip 压缩的消息条数上限；归档 transcript 与落盘工具结果的目录
CONVERSATION_SNIP_LIMIT=50
# 两个目录都会按 user_id 再分一层子目录（与长期记忆同一套命名），便于按用户隔离
TRANSCRIPT_DIR=./.transcripts
TOOL_RESULTS_DIR=./.task_outputs/tool-results
# agent 每次从会话加载的历史消息条数上限（不要小于 MAX_MESSAGES_HARD=200）
AGENT_HISTORY_LIMIT=200

# ---- 日志 ----
LOG_LEVEL=INFO
# 链路追踪里每段输入/输出预览的最大字符数；超长值保留头尾各半并标注原长度
TRACE_TEXT_LIMIT=500

# ---- 成本折算（可选，每百万 token 单价，留空为 0 则只记 token 数不折算金额）----
LLM_INPUT_PRICE_PER_MT=0
LLM_OUTPUT_PRICE_PER_MT=0

# ---- Redis（会话的必需依赖；缓存 / 限流 / 上传队列也复用同一实例）----
# 会话以 Redis 为准，必须配置；连不上时启动即报错（不会静默降级成「新会话」）。
# 缓存、限流、上传队列是可选设施：Redis 不可用时这三块自动失效，链路照常跑。
# 长期记忆已改为文件式（见上面的 MEMORY_ROOT），不再使用 Redis 的 RediSearch。
# 本地起实例：
#   mkdir D:\bishe\.redis
#   docker run -d --name music-rag-redis -p 6379:6379 -v D:\bishe\.redis:/data `
#     --restart unless-stopped redis:8-alpine `
#     redis-server --appendonly yes --requirepass 你的密码
REDIS_URL=
# 键的版本前缀：缓存、会话共用；改版本号（v1 → v2）即可让旧数据整体失效
REDIS_KEY_PREFIX=musicrag:v1
# 会话相关键的存活时间（秒，默认 30 天）：每次读写都会续期，活跃会话不过期。
SESSION_TTL_SECONDS=2592000
# 各层缓存的存活时间（秒）：嵌入 / LLM 映射（查询重写、集合路由）/ 检索结果 / 最终答案
CACHE_TTL_EMBEDDING=86400
CACHE_TTL_LLM=3600
CACHE_TTL_RETRIEVAL=3600
CACHE_TTL_ANSWER=300

# ---- 上传任务队列（需要 Redis；未配 REDIS_URL 时上传退回同步处理，前端直接拿答案）----
# 任务记录与结果的存活秒数：够前端轮询拿到即可，过期后 /api/task/{id} 返回 404
TASK_TTL_SECONDS=7200
# 排队期间的暂存目录：Redis 里只存路径，不塞几十 MB 的字节流
UPLOAD_SPOOL_DIR=./uploaded_files

# ---- 接口限流（令牌桶，复用上面的 Redis；未配 REDIS_URL 或 Redis 连不上时不生效）----
# 置 false 可整体关掉限流（压测、演示时用）
RATE_LIMIT_ENABLED=true
# 容量 = 允许的突发次数；补充速率 = 长期平均速率（次/秒）
# /api/chat 一次要跑 6 次 LLM 加若干外部服务，给宽松些：约 12 次/分钟，最多突发 20 次
RATE_LIMIT_CHAT_CAPACITY=20
RATE_LIMIT_CHAT_REFILL_PER_SEC=0.2
# /api/upload 要走 VLM 逐张识图，单次成本远高于 chat，配额收紧：约 3 次/分钟，最多突发 5 次
RATE_LIMIT_UPLOAD_CAPACITY=5
RATE_LIMIT_UPLOAD_REFILL_PER_SEC=0.05