# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 排除，密钥不会进入 git。

# ---- 对话模型与向量模型（OpenAI 兼容接口）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=

# ---- 联网搜索（Tavily）----
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# ---- 重排序（SiliconFlow）----
RERANK_API_KEY=
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank

# ---- Chroma 向量库持久化目录 ----
CHROMA_PERSIST_DIR=./chroma_db